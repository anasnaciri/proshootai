---
import PricingCard from './PricingCard.astro';

const plans = [
  {
    title: "Starter",
    price: "$9",
    features: [
      "100 AI generations per month",
      "Basic editing tools",
      "720p resolution",
      "Email support"
    ]
  },
  {
    title: "Professional",
    price: "$29",
    features: [
      "500 AI generations per month",
      "Advanced editing tools",
      "4K resolution",
      "Priority support",
      "Custom styles"
    ],
    isPopular: true
  },
  {
    title: "Enterprise",
    price: "$99",
    features: [
      "Unlimited AI generations",
      "Premium editing suite",
      "8K resolution",
      "24/7 dedicated support",
      "API access",
      "Custom training"
    ]
  }
];
---
<section id="pricing" class="py-20 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold mb-4">Simple, Transparent Pricing</h2>
      <p class="text-gray-400 max-w-2xl mx-auto">
        Choose the perfect plan for your needs. All plans include access to our core AI technology.
      </p>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      {plans.map(plan => (
        <PricingCard {...plan} />
      ))}
    </div>
  </div>
</section>