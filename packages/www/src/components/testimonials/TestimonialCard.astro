---
interface Props {
  name: string;
  role: string;
  company: string;
  image: string;
  content: string;
}

const { name, role, company, image, content } = Astro.props;
---
<div class="p-6 rounded-xl bg-dark/30 border border-gray-800 backdrop-blur-sm">
  <p class="text-gray-300 mb-6">"{content}"</p>
  <div class="flex items-center gap-4">
    <img src={image} alt={name} class="w-12 h-12 rounded-full object-cover">
    <div>
      <div class="font-semibold">{name}</div>
      <div class="text-sm text-gray-400">{role} at {company}</div>
    </div>
  </div>
</div>